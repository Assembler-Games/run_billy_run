# === MARS IDE Configuration & Settings ===
# MARS stores its settings locally, but sometimes saves config files in the project path
Mars.properties
Config.properties

# === Common Assembly Toolchain Outputs ===
# Ignore any accidental executables or binary objects if compiling via CLI tools
*.o
*.out
*.obj
*.exe

# === OS & Editor Specifics ===
# Windows thumbnail database / desktop configuration
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS specific files (very common if working on a Mac)
.DS_Store
.AppleDouble
.LSOverride

# Linux/Unix temp files
*~

# === Backup & Temporary Files ===
# Editors like Notepad++, VS Code, or Vim may leave swap/backup files
*.swp
*.bak
*.tmp
*.log
